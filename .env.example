# Comma-separated origins permitted to call the new v1 recovery API.
OTP_RECOVERY_ALLOWED_ORIGINS=https://example.com

# Complete Firebase service-account JSON, or use the base64 alternative.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com"}
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Random server-only secret used to HMAC OTPs, account keys and source keys.
# Use at least 32 unpredictable characters. Do not reuse SENDGRID_API_KEY.
OTP_RECOVERY_PEPPER=replace-with-a-long-random-secret

# Existing SendGrid key used by both legacy OTP and the new recovery mailer.
SENDGRID_API_KEY=replace-with-sendgrid-key

# New recovery branding. The fallback sender email is the legacy verified sender
# so deployment can remain compatible until a dedicated verified sender is set.
SENIOR_RECOVERY_FROM_EMAIL=codetology.adm1n@gmail.com
SENIOR_RECOVERY_FROM_NAME=Senior Citizen Information System

# Set true only behind a trusted reverse proxy that sanitizes X-Forwarded-For.
# Leave false for direct/local deployments.
OTP_RECOVERY_TRUST_PROXY_HEADERS=false
